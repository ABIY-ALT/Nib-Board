# NIB BOD Tracking System — environment
#
# Copy to .env and adjust. Next.js loads .env and .env.local automatically.

# Postgres connection. db:migrate rebuilds the schema from scratch, so never
# point this at a database holding real Board records.
DATABASE_URL="postgresql://postgres:password@localhost:5432/nib board"

# development | production
NODE_ENV=development

# Shared temporary password for the seeded officer accounts. Every one of them
# is flagged must_change_password, so this value cannot be used to do any work.
SEED_PASSWORD="NibBoard#2026temp"

# The seeded administrator (admin@nibbank.et). Exempt from the forced first
# sign-in change, so nothing will ever prompt for this to be replaced — set it
# to a real secret in any environment that is not a local demo.
ADMIN_PASSWORD="Nib@Admin2026"

# Comma-separated extra origins accepted on state-changing requests, for when
# the app is served behind a hostname the Host header does not reflect.
# ALLOWED_ORIGINS=https://board.nibbank.et

# Where uploaded Board papers are stored. MUST be outside this project folder:
# the archive has to survive redeployment, and confidential minutes must not sit
# inside anything that packages or copies the source. The application refuses to
# start an upload if this points back inside the project.
NIB_STORAGE_ROOT="C:\NibBoardStorage"
EMAIL_HOST=mail.nibbank.com.et
EMAIL_PORT=587
EMAIL_USER=no-reply@nibbank.com.et 
EMAIL_PASS=LIAM@@@bin!!!1995!!!
EMAIL_FROM="NIB BOARD <no-reply@nibbank.com.et>"
EMAIL_ALLOW_SELF_SIGNED=true
